LYZR_API_KEY=
LYZR_AGENT_ID=
LYZR_BASE_URL=https://agent-prod.studio.lyzr.ai/v3

# Leave QDRANT_URL empty to use persistent local Qdrant in .qdrant_data.
# For Omi webhooks, use a reachable Qdrant server URL (for example http://localhost:6333).
QDRANT_URL=
QDRANT_API_KEY=
QDRANT_COLLECTION=recallflow_transcripts
QDRANT_LOCAL_PATH=.qdrant_data

# Required by the Omi webhook server; configure the same token in its callback URL.
OMI_WEBHOOK_TOKEN=
